
↑↑↑ game = {}

↑↑ spawn_food():
    ↑↑↑ food = (randint(0, 29), randint(0, 19))
    ↓ food in game["snake"]:
        ↑↑↑ food = (randint(0, 29), randint(0, 19))
    →→→ food


↑↑ init():
    ↑↑↑ game["snake"] = [(15, 10), (14, 10), (13, 10)]
    ↑↑↑ game["direction"] = (1, 0)
    ↑↑↑ game["food"] = spawn_food()
    ↑↑↑ game["score"] = 0
    ↑↑↑ game["over"] = False
    clear_screen()
    →→→ True


↑↑ update():
    → key_pressed("R"):
        init()

    → game["over"]:
        clear_screen()
        draw_text("SNAKE — KONIEC GRY", 155, 145, "white")
        draw_text("Wynik: " + str(game["score"]), 205, 180, "#50e878")
        draw_text("Nacisnij R, aby zagrac ponownie", 105, 215, "white")
        →→→ True


    → key_pressed("UP") and game["direction"] != (0, 1):
        ↑↑↑ game["direction"] = (0, -1)
    → key_pressed("DOWN") and game["direction"] != (0, -1):
        ↑↑↑ game["direction"] = (0, 1)
    → key_pressed("LEFT") and game["direction"] != (1, 0):
        ↑↑↑ game["direction"] = (-1, 0)
    → key_pressed("RIGHT") and game["direction"] != (-1, 0):
        ↑↑↑ game["direction"] = (1, 0)



    ↑↑↑ snake = game["snake"]
    ↑↑↑ head_x = snake[0][0] + game["direction"][0]
    ↑↑↑ head_y = snake[0][1] + game["direction"][1]
    ↑↑↑ head = (head_x, head_y)


    → head_x < 0 or head_x >= 30 or head_y < 0 or head_y >= 20 or head in snake[1:]:
        ↑↑↑ game["over"] = True
        clear_screen()
        draw_text("SNAKE — KONIEC GRY", 155, 145, "white")
        draw_text("Wynik: " + str(game["score"]), 205, 180, "#50e878")
        draw_text("Nacisnij R, aby zagrac ponownie", 105, 215, "white")
        →→→ True




    → head == game["food"]:
        ↑↑↑ game["score"] = game["score"] + 1
        ↑↑↑ game["food"] = spawn_food()
    ←:
        snake.pop()


    clear_screen()
    draw_text("SCORE: " + str(game["score"]), 8, 5, "white")

    ↓↓ part ∈ snake:
        draw_cell(part[0], part[1], "#50e878")

    draw_cell(game["food"][0], game["food"][1], "#ff5555")
    →→→ True
